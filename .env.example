NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only; required for PFY identity reconciliation at runtime and live integration tests.
PFY_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Explicit Phase 2 auth E2E only; point this at the local Inbucket/Mailpit HTTP API.
PFY_SUPABASE_INBUCKET_URL=
# Server-only; shared secret for signing H5P runtime tokens (min 32 chars).
PFY_H5P_RUNTIME_SECRET=change-me-to-a-32-char-minimum-secret-shared-with-runtime
# Server-only; URL of the isolated PFY H5P runtime service.
PFY_H5P_RUNTIME_URL=http://localhost:3001
